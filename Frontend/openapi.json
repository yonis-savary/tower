{
    "openapi": "3.1.0",
    "info": {
        "title": "Tower",
        "version": "0.0.1"
    },
    "paths": {
        "\/api\/access-keys": {
            "get": {
                "summary": "List access keys",
                "description": "The usable access keys of the current workspace",
                "operationId": "listAccessKeys",
                "responses": {
                    "200": {
                        "description": "The access keys",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "integer"
                                            },
                                            "name": {
                                                "type": "string"
                                            },
                                            "client_id": {
                                                "type": "string"
                                            },
                                            "last_used_at": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ]
                                            }
                                        },
                                        "required": [
                                            "id",
                                            "name",
                                            "client_id",
                                            "last_used_at"
                                        ]
                                    }
                                },
                                "example": [
                                    {
                                        "id": 332,
                                        "name": "nostrum quo sequi",
                                        "client_id": "est sed non",
                                        "last_used_at": "2021-01-04"
                                    }
                                ]
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create access key",
                "description": "Creates an access key in the current workspace. The secret is only given by this answer",
                "operationId": "createAccessKey",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "description": "The request does not follow its rules, errors are keyed by field",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ValidationErrors"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "The key and its connector configuration",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "key": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "client_id": {
                                                    "type": "string"
                                                },
                                                "last_used_at": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "client_id",
                                                "last_used_at"
                                            ]
                                        },
                                        "config": {
                                            "type": "object",
                                            "properties": {
                                                "tower_url": {
                                                    "type": "string"
                                                },
                                                "client_id": {
                                                    "type": "string"
                                                },
                                                "secret": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/access-keys\/{key}": {
            "delete": {
                "summary": "Revoke access key",
                "description": "Revokes a key of the current workspace and disconnects the devices using it",
                "operationId": "revokeAccessKey",
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such usable key in the current workspace",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "The key is revoked"
                    }
                }
            }
        },
        "\/api\/access-keys\/{key}\/connector": {
            "post": {
                "summary": "Download preconfigured connector",
                "description": "The Tower connector with this key embedded : it runs without a configuration file. Needs the secret given at creation",
                "operationId": "downloadPreconfiguredConnector",
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "secret": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "secret"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "description": "The request does not follow its rules, errors are keyed by field",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ValidationErrors"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "tower-connector-preconfigured.pyz",
                        "content": {
                            "application\/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such usable key in the current workspace, or wrong secret",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The connector was not built into this image",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/connector": {
            "get": {
                "summary": "Download connector",
                "description": "The Tower connector, to run with a configuration file",
                "operationId": "downloadConnector",
                "responses": {
                    "200": {
                        "description": "tower-connector.pyz",
                        "content": {
                            "application\/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The connector was not built into this image",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/auth\/register": {
            "post": {
                "summary": "Register",
                "description": "Creates an account with its first workspace, then opens a session",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "description": "The request does not follow its rules, errors are keyed by field",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ValidationErrors"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "The created user, now logged in",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "email"
                                    ]
                                },
                                "example": {
                                    "id": 209,
                                    "email": "repellat quo dolore"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Registration is closed on this instance",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "An account already uses this email",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/auth\/login": {
            "post": {
                "summary": "Log in",
                "description": "Opens a session from an email and a password",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "description": "The request does not follow its rules, errors are keyed by field",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ValidationErrors"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "The logged in user",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "email"
                                    ]
                                },
                                "example": {
                                    "id": 209,
                                    "email": "repellat quo dolore"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Wrong email or password, or disabled account",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/auth\/logout": {
            "post": {
                "summary": "Log out",
                "description": "Closes the current session",
                "operationId": "logout",
                "responses": {
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "The session is closed"
                    }
                }
            }
        },
        "\/api\/auth\/me": {
            "get": {
                "summary": "Current user",
                "description": "The user of the current session",
                "operationId": "getCurrentUser",
                "responses": {
                    "200": {
                        "description": "The logged in user",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "email"
                                    ]
                                },
                                "example": {
                                    "id": 209,
                                    "email": "repellat quo dolore"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/devices\/{uuid}\/disconnect": {
            "post": {
                "summary": "Disconnect device",
                "description": "Closes the connection of a device of the current workspace. The connector stops until it is launched again",
                "operationId": "disconnectDevice",
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "The device is asked to disconnect, if it is still connected"
                    }
                }
            }
        },
        "\/api\/workspaces": {
            "get": {
                "summary": "List workspaces",
                "description": "The workspaces the current user is a member of",
                "operationId": "listWorkspaces",
                "responses": {
                    "200": {
                        "description": "The workspaces of the user",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "integer"
                                            },
                                            "name": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "id",
                                            "name"
                                        ]
                                    }
                                },
                                "example": [
                                    {
                                        "id": 959,
                                        "name": "aut aspernatur sed"
                                    }
                                ]
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/workspaces\/current": {
            "get": {
                "summary": "Current workspace",
                "description": "The workspace selected in the current session",
                "operationId": "getCurrentWorkspace",
                "responses": {
                    "200": {
                        "description": "The selected workspace",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "name"
                                    ]
                                },
                                "example": {
                                    "id": 959,
                                    "name": "aut aspernatur sed"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The user belongs to no workspace",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Select workspace",
                "description": "Changes the workspace of the current session",
                "operationId": "selectWorkspace",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "workspace": {
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "workspace"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "description": "The request does not follow its rules, errors are keyed by field",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ValidationErrors"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "The newly selected workspace",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "name"
                                    ]
                                },
                                "example": {
                                    "id": 959,
                                    "name": "aut aspernatur sed"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The workspace does not exist or the user is not a member of it",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/workspaces\/current\/socket": {
            "get": {
                "summary": "Workspace socket",
                "description": "The websocket URL following the devices of the current workspace, valid for a minute",
                "operationId": "getWorkspaceSocket",
                "responses": {
                    "200": {
                        "description": "The URL to open",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "url": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The user belongs to no workspace",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ValidationErrors": {
                "anyOf": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#\/components\/schemas\/ValidationErrors"
                        }
                    }
                ]
            }
        }
    }
}