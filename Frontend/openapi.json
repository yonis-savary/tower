{
    "openapi": "3.1.0",
    "info": {
        "title": "Tower",
        "version": "0.0.1"
    },
    "paths": {
        "\/api\/auth\/register": {
            "post": {
                "summary": "Register",
                "description": "Creates an account with its first workspace, then opens a session",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "description": "The request does not follow its rules, errors are keyed by field",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ValidationErrors"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "The created user, now logged in",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "email"
                                    ]
                                },
                                "example": {
                                    "id": 209,
                                    "email": "repellat quo dolore"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Registration is closed on this instance",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "An account already uses this email",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/auth\/login": {
            "post": {
                "summary": "Log in",
                "description": "Opens a session from an email and a password",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "description": "The request does not follow its rules, errors are keyed by field",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ValidationErrors"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "The logged in user",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "email"
                                    ]
                                },
                                "example": {
                                    "id": 209,
                                    "email": "repellat quo dolore"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Wrong email or password, or disabled account",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/auth\/logout": {
            "post": {
                "summary": "Log out",
                "description": "Closes the current session",
                "operationId": "logout",
                "responses": {
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "The session is closed"
                    }
                }
            }
        },
        "\/api\/auth\/me": {
            "get": {
                "summary": "Current user",
                "description": "The user of the current session",
                "operationId": "getCurrentUser",
                "responses": {
                    "200": {
                        "description": "The logged in user",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "email"
                                    ]
                                },
                                "example": {
                                    "id": 209,
                                    "email": "repellat quo dolore"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No active session",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ValidationErrors": {
                "anyOf": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#\/components\/schemas\/ValidationErrors"
                        }
                    }
                ]
            }
        }
    }
}