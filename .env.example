# To set before the first start

# Printed by `php do key:generate`
APP_KEY=
DB_PASSWORD=
# [Docker Only] Used by the mysql container on its first start only
DB_ROOT_PASSWORD=
# Shared by the websocket service and the backend broadcasting to it : a long random string
WEBSOCKET_SECRET=

# Application

# debug, dev, local or test in development ; prod on a server
env=debug
# Anyone reaching the instance may create an account when true. Closed by default : accounts are
# then created with `php do app:create-user <email>`
REGISTRATION_OPEN=false

# Docker

# [Docker Only]
# This variable behave as a prefix for your images name
# Redefine this variable as soon as possible
COMPOSE_PROJECT_NAME=app

# [Docker Only]
# Every container runs as this user, which owns Storage/ and .env : `id -u` and `id -g` on the host
# Rebuild the image after changing them
UID=1000
GID=1000

# Database

# MySQL : the host is the service name of docker-compose.yml
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tower
DB_USER=tower

# Ports

# [Docker Only] Host ports, in development and in production. Change them if they are taken
# The application (frontend, API, webhooks), served by nginx
TOWER_HTTP_PORT=8081
# The websocket server the devices and browsers connect to
TOWER_WEBSOCKET_PORT=8088

# Push notifications

# Printed by `php do app:push-keys`. Generate them once : new keys invalidate every browser subscription
# Empty : push notifications are hidden
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How the push services (Google, Apple, Mozilla) can reach the administrator : mailto:you@example.com
VAPID_SUBJECT=

# Websocket

# Public address of the websocket server, given to the devices and browsers, without a path
# Behind a TLS reverse proxy : wss://tower.example.com. Empty : ws://localhost:$TOWER_WEBSOCKET_PORT, for local use only
TOWER_WEBSOCKET_URL=
# Comma-separated origins a browser may open a websocket from (default: the local Vite and nginx)
# WEBSOCKET_ALLOWED_ORIGINS=https://tower.example.com

# Development

# [Docker Only] Host port publishing the dev mysql container, change it if 3306 is taken
TOWER_MYSQL_DEV_PORT=3306
# Port of the Vite dev server, also the origin the websocket server accepts by default
TOWER_VITE_DEV_PORT=5173
